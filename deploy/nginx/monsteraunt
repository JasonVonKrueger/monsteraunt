# /etc/nginx/sites-available/monsteraunt
#
# Monsteraunt: nginx serves the built client; Socket.IO goes to the Node app
# run by pm2 (ecosystem.config.cjs) on 127.0.0.1:3040.
#   Deploy: git pull && npm ci --include=dev && npm run build && pm2 restart monsteraunt

server {
    listen 443 ssl;
    server_name monsteraunt.nervoussow.com;

    root /home/hosted-apps/monsteraunt/client/dist;
    index index.html;

    location / {
        try_files $uri $uri/ /index.html;
    }

    location = /index.html {
        add_header Cache-Control "no-cache";
    }

    # Must match PORT in ecosystem.config.cjs. Rooms live in memory: one Node process only.
    location /socket.io/ {
        proxy_pass http://127.0.0.1:3040;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 75s;
    }

    ssl_certificate /etc/letsencrypt/live/monsteraunt.nervoussow.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/monsteraunt.nervoussow.com/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;
}

server {
    listen 80;
    server_name monsteraunt.nervoussow.com;

    return 301 https://$host$request_uri;
}
